{
  "version": 2,
  "regions": ["fra1"],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["server/**", "advisor_engine.py"] }
    }
  ],
  "crons": [
    { "path": "/api/cron/snapshot", "schedule": "5 0 * * *" },
    { "path": "/api/cron/telegram-daily", "schedule": "0 6 * * *" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": { "Strict-Transport-Security": "max-age=63072000; includeSubDomains; preload" },
      "continue": true
    },
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    {
      "src": "/assets/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "dest": "/frontend/assets/$1"
    },
    { "src": "/(favicon\\.svg|favicon\\.png|icons\\.svg|qirat-mark\\.png|apple-touch-icon\\.png|icon-512\\.png|og-image\\.png|robots\\.txt|sitemap\\.xml)", "dest": "/frontend/$1" },
    { "src": "/(fr/|en/)?learn/law-tunisia/?", "status": 301, "headers": { "Location": "/$1learn/crypto-law-arab-world" } },
    { "src": "/(fr/|en/)?learn/?", "dest": "/frontend/$1learn/index.html", "check": true },
    { "src": "/(fr/|en/)?learn/([a-z0-9-]+)/?", "dest": "/frontend/$1learn/$2/index.html", "check": true },
    {
      "src": "/(mascot|cast|stories)/(.*)",
      "headers": { "Cache-Control": "public, max-age=86400" },
      "dest": "/frontend/$1/$2"
    },
    { "src": "/((?!_vercel/).*)", "dest": "/frontend/index.html" }
  ]
}
