{
  "version": 2,
  "regions": ["fra1"],
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["server/**", "advisor_engine.py", "notifications.py"] }
    }
  ],
  "crons": [
    { "path": "/api/cron/snapshot", "schedule": "5 0 * * *" },
    { "path": "/api/cron/telegram-daily", "schedule": "0 6 * * *" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/assets/(.*)", "dest": "/frontend/assets/$1" },
    { "src": "/(favicon\\.svg|icons\\.svg)", "dest": "/frontend/$1" },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
