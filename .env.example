# Copy to .env for local dev, or set these in Render → Environment.
# .env is gitignored — never commit real keys.

# --- AI provider (briefing + chat). With none set, the app runs fully on the
# heuristic engine and the UI hides the AI panels. Precedence:
# ANTHROPIC_API_KEY > GROQ_API_KEY > OPENAI_API_KEY.

# Groq — free, OpenAI-compatible. Recommended. Just set this one key; the base
# URL and model default to Groq automatically. Get a key at console.groq.com/keys
GROQ_API_KEY=

# Anthropic (paid) — highest quality, used first if set.
ANTHROPIC_API_KEY=

# OpenAI (paid) — optional fallback, only used if the two above are unset.
OPENAI_API_KEY=

# Override the OpenAI-compatible endpoint (rarely needed; Groq's is the default
# when GROQ_API_KEY is set). Leave blank for real OpenAI.
OPENAI_BASE_URL=

# AI usage limits. These defend a PAID API key; with a free provider (Groq)
# they all default to 0 = unlimited. Set any to a positive number to re-enable
# it: AI_RATE_LIMIT is a per-IP burst cap over AI_RATE_WINDOW seconds,
# AI_DAILY_IP_LIMIT is each visitor's daily allowance, AI_DAILY_LIMIT is the
# GLOBAL hard ceiling per UTC day.
#AI_RATE_LIMIT=0
#AI_RATE_WINDOW=300
#AI_DAILY_IP_LIMIT=0
#AI_DAILY_LIMIT=0
# Anthropic model override — cheaper options: claude-haiku-4-5, claude-sonnet-4-6.
#ANTHROPIC_MODEL=claude-opus-4-8
# Model for the OpenAI-compatible path. Defaults to llama-3.3-70b-versatile
# when GROQ_API_KEY is set, else gpt-4o-mini. Override here if needed.
#OPENAI_MODEL=

# Upstash Redis (free tier) — REQUIRED for the rate limit / daily budget /
# narrative cache to hold on serverless (Vercel). Without it those guards are
# per-instance only. On Vercel: Marketplace → Upstash → connect, and these are
# injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Protects /api/cron/snapshot. Vercel Cron sends it as a bearer token when set.
CRON_SECRET=

# Optional alert channels (already supported by notifications.py).
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
