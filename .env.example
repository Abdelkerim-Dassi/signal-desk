# Copy to .env for local dev, or set these in Render → Environment.
# .env is gitignored — never commit real keys.

# Enables the AI briefing + chat (Day 3+). Without it the app runs fully on the
# heuristic engine and the UI hides the AI panels.
ANTHROPIC_API_KEY=

# Optional alert channels (already supported by notifications.py).
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
