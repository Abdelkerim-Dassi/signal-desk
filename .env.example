# Copy to .env for local dev, or set these in Render → Environment.
# .env is gitignored — never commit real keys.

# Enables the AI briefing + chat (Day 3+). Without it the app runs fully on the
# heuristic engine and the UI hides the AI panels.
ANTHROPIC_API_KEY=
# Fallback provider when ANTHROPIC_API_KEY is unset (gpt-4o-mini by default).
OPENAI_API_KEY=

# AI cost controls (defaults shown). AI_DAILY_IP_LIMIT is each visitor's daily
# allowance; AI_DAILY_LIMIT is the GLOBAL hard ceiling per UTC day.
#AI_RATE_LIMIT=20
#AI_RATE_WINDOW=300
#AI_DAILY_IP_LIMIT=1
#AI_DAILY_LIMIT=100
# Anthropic model override — cheaper options: claude-haiku-4-5, claude-sonnet-4-6.
#ANTHROPIC_MODEL=claude-opus-4-8
#OPENAI_MODEL=gpt-4o-mini

# Upstash Redis (free tier) — REQUIRED for the rate limit / daily budget /
# narrative cache to hold on serverless (Vercel). Without it those guards are
# per-instance only. On Vercel: Marketplace → Upstash → connect, and these are
# injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional alert channels (already supported by notifications.py).
DISCORD_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
