# Copy to .env for local dev, or set these in Vercel → Settings → Environment Variables.
# .env is gitignored — never commit real keys.

# --- AI provider (briefing + chat). With none set, the app runs fully on the
# heuristic engine and the UI hides the AI panels. Precedence:
# ANTHROPIC_API_KEY > GROQ_API_KEY > OPENAI_API_KEY.

# Groq — free, OpenAI-compatible. Recommended. Just set this one key; the base
# URL and model default to Groq automatically. Get a key at console.groq.com/keys
GROQ_API_KEY=

# Anthropic (paid) — highest quality, used first if set.
ANTHROPIC_API_KEY=

# OpenAI (paid) — optional fallback, only used if the two above are unset.
OPENAI_API_KEY=

# Override the OpenAI-compatible endpoint (rarely needed; Groq's is the default
# when GROQ_API_KEY is set). Leave blank for real OpenAI.
OPENAI_BASE_URL=

# AI usage limits. These defend a PAID API key; with a free provider (Groq)
# they all default to 0 = unlimited. Set any to a positive number to re-enable
# it: AI_RATE_LIMIT is a per-IP burst cap over AI_RATE_WINDOW seconds,
# AI_DAILY_IP_LIMIT is each visitor's daily allowance, AI_DAILY_LIMIT is the
# GLOBAL hard ceiling per UTC day.
#AI_RATE_LIMIT=0
#AI_RATE_WINDOW=300
#AI_DAILY_IP_LIMIT=0
#AI_DAILY_LIMIT=0
# Anthropic model override — cheaper options: claude-haiku-4-5, claude-sonnet-4-6.
#ANTHROPIC_MODEL=claude-opus-4-8
# Model for the OpenAI-compatible path. Defaults to openai/gpt-oss-120b
# when GROQ_API_KEY is set, else gpt-4o-mini. Override here if needed.
#OPENAI_MODEL=

# Upstash Redis (free tier) — REQUIRED for the rate limit / daily budget /
# narrative cache to hold on serverless (Vercel). Without it those guards are
# per-instance only. On Vercel: Marketplace → Upstash → connect, and these are
# injected automatically.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Scheduled jobs and the private stats send one of these as a bearer token.
# CRON_SECRET is what Vercel Cron sends; JOBS_SECRET is what the GitHub Actions
# schedule sends. On the deployed app, jobs are refused when neither is set.
CRON_SECRET=
JOBS_SECRET=

# Owner's read-only key for the private counters: GET /api/stats with the header
# "X-Stats-Key: <this value>". Local only: it is NOT set on Vercel. The app
# checks it against STATS_READER_SHA256 in server/main.py, so to change the key,
# generate a new random value here and put its SHA-256 there.
STATS_READ_KEY=

# Telegram bot. OWNER_CHAT_ID is the one private chat that receives the private
# reports, /stats and the posts to approve. Send /claim to the bot to see a
# chat's id. Nobody becomes the owner by asking.
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=

# Scam check limits, per minute: per address, and for the whole app.
# Phones on one mobile carrier share an address, so keep the first one generous.
#SCAMCHECK_RATE_LIMIT=120
#SCAMCHECK_GLOBAL_LIMIT=900
